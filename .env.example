# ---------------------------------------------------------------------------
# API configuration
#
# The backend lives in a separate repo/deployment. Two variables, two jobs:
#
# VITE_API_URL       Full API base that request paths are appended to.
#                    Include the /api suffix. Defaults to '/api' when unset.
# VITE_DEV_API_PROXY Dev-server proxy target. Must be a bare ORIGIN with NO
#                    path — a path here produces /api/api/... requests.
#                    Only read by vite.config.js; ignored in production builds.
# ---------------------------------------------------------------------------

# Local development (recommended): leave VITE_API_URL unset so calls stay
# relative and get proxied — this avoids CORS entirely.
# VITE_DEV_API_PROXY=http://localhost:5000

# Local development against the deployed backend (needs CORS on the backend):
# VITE_API_URL=https://your-backend-host.example.com/api

# Production: set this in the Vercel dashboard to the deployed backend's base.
# The backend must send Access-Control-Allow-Origin for this site's origin and
# allow the Authorization header.
# VITE_API_URL=https://your-backend-host.example.com/api
VITE_N8N_WEBHOOK=https://your-n8n-instance.webhook/your-webhook-id
VITE_N8N_FORM_URL=https://your-n8n-instance.webhook/your-form-id
# Hospital Information
VITE_HOSPITAL_NAME="Medovate Hospital"
VITE_HOSPITAL_PHONE="+1 (555) 123-4567"
VITE_HOSPITAL_EMAIL="info@medovate.com"
VITE_HOSPITAL_ADDRESS="123 Medical Center Drive, Healthcare City, HC 12345"

# Social Media Links
VITE_FACEBOOK_URL="https://facebook.com/medovate"
VITE_TWITTER_URL="https://twitter.com/medovate"
VITE_INSTAGRAM_URL="https://instagram.com/medovate"
VITE_LINKEDIN_URL="https://linkedin.com/company/medovate"

# Contact Form Settings
VITE_CONTACT_EMAIL="contact@medovate.com"
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""